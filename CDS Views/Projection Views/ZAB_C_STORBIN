@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Projection View Warehouse Store Bin'
@Metadata.ignorePropagatedAnnotations: true
@Metadata.allowExtensions: true
define view entity ZAB_C_STORBIN
  as projection on ZAB_I_StorBin
{
  key WarehouseId,
  key BinId,
      @ObjectModel.text.element: [ 'binText' ]
      BinType,
      _bintype.Text as binText,
      @Semantics.quantity.unitOfMeasure: 'unit'
      MaxCapacity,
      @Semantics.quantity.unitOfMeasure: 'unit'
      CurrentQty,
      Unit,
      @ObjectModel.text.element: [ 'OverallStatusText' ]
      Status,
      _STATUS.Text  as OverallStatusText,
      LocalCreatedBy,
      LocalCreatedAt,
      LocalLastChangedBy,
      LocalLastChangedAt,
      LastChangedAt,
      OccupancyCriticality,

      /* Associations */
      _StockItem : redirected to composition child ZAB_C_STOCKITEM,
      _warehouse : redirected to parent ZAB_C_Warehouse,
      _STATUS,
      _bintype
}
