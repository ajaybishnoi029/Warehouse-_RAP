CLASS lhc_stockitem DEFINITION INHERITING FROM cl_abap_behavior_handler.

  PRIVATE SECTION.

    METHODS ValidateQty FOR VALIDATE ON SAVE
       keys FOR StockItem~ValidateQty.

    METHODS CurrentQty FOR DETERMINE ON MODIFY  "--SAVE
       keys FOR StockItem~CurrentQty.
    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      keys REQUEST requested_authorizations FOR StockItem RESULT result.

    METHODS transferStock FOR MODIFY
       keys FOR ACTION StockItem~transferStock RESULT result.

ENDCLASS.

CLASS lhc_stockitem IMPLEMENTATION.

  METHOD ValidateQty.

    DATA: ls_sqty TYPE kwmeng.

    READ ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE                  " To get Max. Qty
    ENTITY StorBin
    FIELDS ( MaxCapacity ) WITH CORRESPONDING #( keys )
    RESULT DATA(lT_maxQty).

    DATA(ls_max_qty) = REDUCE kwmeng( INIT sum = 0
                                          FOR item IN lT_maxQty
                                          NEXT sum = sum + item-MaxCapacity ).


    READ ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE                  " To Read All Stock Item for Qty Present
      ENTITY StorBin BY \_stockitem
        FIELDS ( Quantity )  WITH CORRESPONDING #(   keys )
        RESULT DATA(lt_stockqty)
        FAILED DATA(lt_failed).


    LOOP AT lt_stockqty INTO DATA(ls_stockqty).
      ls_sqty += ls_stockqty-Quantity.
    ENDLOOP.


    IF ls_sqty > ls_max_qty.
      APPEND VALUE #( %tky = ls_stockqty-%tky ) TO failed-stockitem.

      APPEND VALUE #( %tky = keys[ 1 ]-%tky
                     %msg = new_message_with_text(
                              severity = if_abap_behv_message=>severity-error
                              text     = |Total Qty. can't exceed Max. Capacity:{ ls_max_qty }|
                            )
                      ) TO reported-stockitem.
    ENDIF.

*    READ ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE                  " To Read Current Qty
*    ENTITY StockItem
*    FIELDS ( WarehouseId  BinId Quantity ) WITH CORRESPONDING #(   keys )
*    RESULT DATA(lt_stockitm).

  ENDMETHOD.

  METHOD CurrentQty.                                                " Update Current Qty in the Store Bin


    DATA:  ls_totQty TYPE kwmeng.
    DATA: lt_update TYPE TABLE FOR UPDATE zab_i_storbin.

    READ ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE                  " To Read All Stock Item for Qty Present
        ENTITY StorBin BY \_stockitem
          FIELDS ( Quantity )  WITH CORRESPONDING #(   keys )
          RESULT DATA(lt_stockqty)
          FAILED DATA(lt_failed).

    LOOP AT lt_stockqty INTO DATA(ls_stockqty).
      ls_totQty += ls_stockqty-Quantity.
    ENDLOOP.

    lt_update = VALUE #(
      ( WarehouseId = ls_stockqty-WarehouseId
        BinId       = ls_stockqty-BinId
        CurrentQty  = ls_totqty   " new quantity you calculated
        %control-CurrentQty = if_abap_behv=>mk-on )   " mark field as changed
    ).


    MODIFY ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE            " Update Current Qty
      ENTITY StorBin
        UPDATE FIELDS ( CurrentQty )
        WITH lt_update
      MAPPED DATA(lt_mapped)
      FAILED DATA(lt_failed_qty)
      REPORTED DATA(lt_reported).

  ENDMETHOD.

  METHOD get_instance_authorizations.
  ENDMETHOD.

  METHOD transferStock.
    DATA lt_create TYPE TABLE FOR CREATE zab_i_storbin\_stockitem.



    LOOP AT keys INTO DATA(ls_key).

      " Entity's own keys (from the row that was clicked)
      DATA(lv_warehouse_id) = ls_key-WarehouseId.
      DATA(lv_bin_id)        = ls_key-BinId.
      DATA(lv_stock_item_id) = ls_key-StockItemId.

      " Action's input parameters (from the popup the user filled in)
      DATA(lv_source_wh)   = ls_key-%param-SourceWarehouseId.
      DATA(lv_target_bin)  = ls_key-%param-TargetBinId.
      DATA(lv_transfer_qty) = ls_key-%param-TransferQty.

    ENDLOOP.

    READ ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE
    ENTITY StockItem
    ALL FIELDS WITH CORRESPONDING #( keys )
    RESULT DATA(lt_stockitm_ts)
    FAILED DATA(lt_failed_itm).
    DATA(ls_stockitm_ts) = VALUE #( lt_stockitm_ts[ 1 ] OPTIONAL ).

    READ ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE
    ENTITY StorBin
    ALL FIELDS  WITH VALUE #( ( WarehouseId = ls_stockitm_ts-WarehouseId BinId = lv_target_bin ) )
    RESULT DATA(lt_storbin_ts)
    FAILED DATA(lt_failed).

    DATA(ls_storbin_ts) = VALUE #( lt_storbin_ts[ 1 ] OPTIONAL ).




    DATA(lv_binspace) = ls_storbin_ts-MaxCapacity - ls_storbin_ts-CurrentQty.

    IF  ls_storbin_ts-MaxCapacity <  ( ls_storbin_ts-CurrentQty + lv_transfer_qty ).


      APPEND VALUE #( %tky = keys[ 1 ]-%tky
                     %msg = new_message_with_text(
                              severity = if_abap_behv_message=>severity-error
                              text     = |Avilable Space in Bin ({ lv_target_bin }) :{ lv_binspace } |
                            )
                      ) TO reported-stockitem.

    ELSE.


      lt_create = VALUE #(
    ( WarehouseId = ls_stockitm_ts-WarehouseId
      BinId       = lv_target_bin                 " the EXISTING target bin
      %target = VALUE #(
        ( %cid        = |NEW{ sy-tabix }|
          StockItemId = |T{ ls_stockitm_ts-StockItemId }|
          MaterialId  = ls_stockitm_ts-MaterialId
          Quantity    = lv_transfer_qty
          Unit        = ls_stockitm_ts-Unit
          BatchNumber = ls_stockitm_ts-BatchNumber )
      ) )
  ).
      " ... after the loop, execute the create ...

      MODIFY ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE
  ENTITY StorBin
    CREATE BY \_stockitem
      FIELDS ( StockItemId MaterialId Quantity Unit BatchNumber )
      WITH lt_create
  MAPPED DATA(lt_mapped)
  FAILED DATA(lt_failed_crt)
  REPORTED DATA(lt_reported).

      IF lt_failed_crt-stockitem IS NOT INITIAL.

        LOOP AT lt_reported-stockitem INTO DATA(ls_reported).     "  Creation failed
          APPEND VALUE #(
            %msg = ls_reported-%msg
          ) TO reported-storbin.
        ENDLOOP.

      ELSE.                                                        " Update Current Qty in Stock

        DATA: lt_update TYPE TABLE FOR UPDATE ZAB_I_StockItem.
        lt_update = VALUE #(
      ( WarehouseId = ls_stockitm_ts-WarehouseId
        BinId       = ls_stockitm_ts-BinId
        StockItemId = ls_stockitm_ts-StockItemId
        Quantity  = ls_stockitm_ts-Quantity - lv_transfer_qty   " new quantity you calculated
        %control-Quantity = if_abap_behv=>mk-on )   " mark field as changed
    ).


        MODIFY ENTITIES OF ZAB_I_Warehouse IN LOCAL MODE            " Update Quantity After Stock Transfer
          ENTITY StockItem
            UPDATE FIELDS ( Quantity )
            WITH lt_update
          MAPPED DATA(lt_mapped_upd)
          FAILED DATA(lt_failed_qty)
          REPORTED DATA(lt_reported_upd).


        APPEND VALUE #( %tky = ls_key-%tky
                     %msg = new_message_with_text( severity = if_abap_behv_message=>severity-success
                                               text     = |Stock transferred successfully to { ls_key-%param-TargetBinId }| ) )
           TO reported-stockitem.
      ENDIF.

      result = VALUE #( FOR item IN lt_stockitm_ts
      ( %tky   = item-%tky
        %param = item ) ).

    ENDIF.

  ENDMETHOD.

ENDCLASS.



CLASS lhc_Warehouse DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.


    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      keys REQUEST requested_authorizations FOR Warehouse RESULT result.
    METHODS get_global_authorizations FOR GLOBAL AUTHORIZATION
      REQUEST requested_authorizations FOR warehouse RESULT result.


ENDCLASS.

CLASS lhc_Warehouse IMPLEMENTATION.


  METHOD get_instance_authorizations.
  ENDMETHOD.

  METHOD get_global_authorizations.
  ENDMETHOD.

ENDCLASS.
