define table zwm_warehouse {

  key client            : abap.clnt not null;
  key warehouse_id      : abap.char(10) not null;
  name                  : abap.char(40);
  city                  : /dmo/city;
  country_code          : land1;
  phone_number          : /dmo/phone_number;
  email_address         : /dmo/email_address;
  status                : abap.char(1);
